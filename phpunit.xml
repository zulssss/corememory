<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <!--
            Concurrency tests need two real database connections committing
            against each other, so they cannot run inside RefreshDatabase's
            wrapping transaction. They truncate instead. See tests/Pest.php.
        -->
        <testsuite name="Concurrency">
            <directory>tests/Concurrency</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            Image conversions (media library + image-optimizer) hold whole
            bitmaps in memory, and the performance tests attach real files.
            PHP's 128M default is not enough and the suite dies mid-run with a
            fatal that looks unrelated to the test that triggered it.
        -->
        <ini name="memory_limit" value="512M"/>

        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            Tests run against a real MySQL/MariaDB database, not SQLite.

            This is deliberate and costs a little speed. The availability engine's
            core guarantee is a UNIQUE(event_date, session_slot) index and the
            MySQL error 1062 raised when two concurrent transactions collide on
            it. SQLite reports a different error, and its locking model does not
            reproduce the concurrent-submit race at all — so an in-memory SQLite
            suite would happily pass while the real double-booking bug shipped.

            corememory_testing is a separate database; `php artisan test` never
            touches your dev data.
        -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="corememory_testing"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
