#!/bin/bash
#
# CoreMemory — the Vercel PUBLIC PREVIEW. Not the real site, and no admin.
#
#   ./scripts/vercel deploy   snapshot the public content, bundle it with the
#                             photos, and deploy to *.vercel.app
#
# Needs `npx vercel login` once. See DEPLOYMENT.md → "Public preview on Vercel".
#
set -euo pipefail
cd "$(dirname "$0")/.."

REPO="$PWD"
BUILD="$HOME/.corememory/vercel/corememory"   # folder name = Vercel project name

[ "${1:-}" = deploy ] || { sed -n 3,8p "$0"; exit 1; }

# Generated once and kept, so visitors' sessions survive a redeploy.
touch .env.vercel
APP_KEY="$(grep -E '^APP_KEY=.+' .env.vercel | cut -d= -f2- || true)"
if [ -z "$APP_KEY" ]; then
    APP_KEY="base64:$(openssl rand -base64 32)"
    grep -v '^APP_KEY=' .env.vercel > .env.vercel.tmp || true
    echo "APP_KEY=$APP_KEY" >> .env.vercel.tmp && mv .env.vercel.tmp .env.vercel
fi

echo "→ assembling $BUILD"
mkdir -p "$BUILD"
# storage/app/private (invoices, receipts) is deliberately left out.
rsync -a --delete \
    --exclude=.vercel --exclude=.git --exclude=.gitignore --exclude='.env*' \
    --exclude=/vendor --exclude=/node_modules --exclude=/tests --exclude=/public/hot \
    --exclude=/public/storage --exclude=/storage/logs/ --exclude=/storage/framework/ \
    --exclude=/storage/app/private/ \
    "$REPO/" "$BUILD/"
# Photos as static files on Vercel's CDN. The copy under storage/ stays for
# PHP, which reads the tiny blur placeholders.
rsync -a --delete "$REPO/storage/app/public/" "$BUILD/public/storage/"
printf '.env*\n' > "$BUILD/.vercelignore"

echo "→ snapshotting public content"
SNAP="$BUILD/database/review.sqlite"
rm -f "$SNAP" && touch "$SNAP"
DB_CONNECTION=sqlite DB_DATABASE="$SNAP" CACHE_STORE=array php artisan migrate --force --no-interaction >/dev/null
php scripts/vercel-snapshot.php "$SNAP"

echo "→ deploying"
npx --yes vercel@latest deploy --prod --yes --cwd "$BUILD" \
    -e APP_NAME=CoreMemory -e APP_ENV=production -e APP_DEBUG=false -e "APP_KEY=$APP_KEY" \
    -e SITE_NOINDEX=true -e 'TRUSTED_PROXIES=*' \
    -e DB_CONNECTION=sqlite \
    -e CACHE_STORE=database -e SESSION_DRIVER=database -e QUEUE_CONNECTION=sync \
    -e QUEUE_CONVERSIONS_BY_DEFAULT=false -e MAIL_MAILER=log \
    -e MEDIA_DISK=public -e FILESYSTEM_DISK=tmp_private
