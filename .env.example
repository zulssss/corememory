###############################################################################
# APPLICATION
###############################################################################
APP_NAME=CoreMemory
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Malaysia. Every date the studio and its clients see is Kuala Lumpur local time.
APP_TIMEZONE=Asia/Kuala_Lumpur

# Copy is English, but every UI string goes through lang/ files so a "ms"
# locale can be dropped in later without touching a single Blade template.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_MY

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

###############################################################################
# LOGGING
###############################################################################
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

###############################################################################
# DATABASE
#
# Local dev runs a project-owned MariaDB on port 3307 (see CLAUDE.md § Database).
# Port 3307 rather than 3306 so it never collides with XAMPP's own MySQL.
###############################################################################
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=corememory
DB_USERNAME=corememory
DB_PASSWORD=

# Separate database for the test suite, so `php artisan test` never touches
# your dev data. Used by phpunit.xml.
DB_TEST_DATABASE=corememory_testing

###############################################################################
# SESSION / CACHE / QUEUE
#
# Queue is `database` locally so no Redis is needed to develop. Emails and PDF
# generation are queued — the web request must never wait on them.
# On the VPS this becomes `redis`.
###############################################################################
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Everything queued — booking confirmations, enquiry notifications, invoice
# PDFs — needs a worker (`php artisan queue:work`). Locally there usually isn't
# one, so those jobs sit in the jobs table forever and the studio silently
# never hears about an enquiry. `sync` runs them during the request instead.
#
# Production uses redis with the Supervisor worker in DEPLOYMENT.md.
QUEUE_CONNECTION=sync
# Image conversions run on the queue by default, which needs a worker
# (`php artisan queue:work`). Locally there usually isn't one, so an uploaded
# photograph would be served at full size — 2.9 MB instead of a 228 KB WebP —
# until someone remembered to start one. false generates them during the save
# instead: a few seconds slower per image, but always correct.
#
# Production keeps this true and runs the Supervisor worker from DEPLOYMENT.md.
QUEUE_CONVERSIONS_BY_DEFAULT=false
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

###############################################################################
# MAIL
#
# `log` writes emails to storage/logs/laravel.log instead of sending them,
# so local development never emails a real person by accident.
###############################################################################
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@corememory.test"
MAIL_FROM_NAME="${APP_NAME}"

# Where booking enquiry notifications land for the studio team.
STUDIO_NOTIFICATION_EMAIL="studio@corememory.test"

###############################################################################
# BOOKING RULES
#
# All confirmed in planning. Changing these changes what the calendar allows;
# they are read via config/booking.php, never read from env directly.
###############################################################################
# How far ahead a couple must book, and how far ahead they may book.
BOOKING_MIN_LEAD_DAYS=14
BOOKING_MAX_AHEAD_MONTHS=24

# A pending enquiry nobody actions is auto-cancelled after this many days,
# so tentative notices don't linger on a popular date forever.
BOOKING_PENDING_LAPSE_DAYS=14

# Default deposit, overridable by the owner in admin settings.
BOOKING_DEPOSIT_PERCENT=30

###############################################################################
# INVOICING
###############################################################################
INVOICE_NUMBER_PREFIX=CM
BOOKING_REFERENCE_PREFIX=CM

###############################################################################
# FRONTEND
###############################################################################
VITE_APP_NAME="${APP_NAME}"
